{
  "name": "forge-desktop-app",
  "version": "1.6.1",
  "description": "Forge - Génère ton jeu Roblox avec l'IA",
  "main": "main.js",
  "scripts": {
    "test": "node --test lib/*.test.js",
    "benchmark:credits": "node tools/credit-benchmark.cjs",
    "postinstall": "node scripts/postinstall.js",
    "start": "electron .",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "setup:core": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1 -SkipAgents",
    "setup:mac": "bash ./scripts/setup-macos.sh",
    "rebuild:pty": "npx electron-rebuild -f -w node-pty && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sign-node-pty.ps1",
    "rebuild:pty:mac": "electron-rebuild -f -w node-pty",
    "verify:pty": "electron scripts/verify-pty-runtime.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:mac:release": "electron-builder --mac --arm64 --x64 -c.mac.notarize=true",
    "publish": "electron-builder --win --publish always",
    "runtime:prepare": "npm run runtime:prepare:win",
    "runtime:prepare:win": "python scripts/prepare-python-runtime.py && python scripts/prepare-node-runtime.py && node scripts/verify-node-runtime.cjs && node scripts/verify-python-runtime.cjs",
    "runtime:prepare:mac": "python3 scripts/prepare-node-runtime.py --all-macos && node scripts/verify-node-runtime.cjs --platform=darwin --arch=arm64 && node scripts/verify-node-runtime.cjs --platform=darwin --arch=x64",
    "runtime:verify": "node scripts/verify-node-runtime.cjs && node scripts/verify-python-runtime.cjs",
    "validate:p0:windows": "node scripts/validate-packaged-windows.cjs",
    "release:gate": "node scripts/release-gate.cjs"
  },
  "keywords": [],
  "author": "Forge Studio",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "three": "^0.137.0"
  },
  "build": {
    "appId": "com.forge.app",
    "productName": "Forge",
    "npmRebuild": true,
    "publish": {
      "provider": "github",
      "owner": "forgestudioapp",
      "repo": "forge-desktop-app",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/logos/forge-logo.ico",
      "signExts": [".node", ".dll"],
      "extraResources": [
        { "from": "runtimes/python-win-x64-u2net", "to": "runtimes/python-win-x64-u2net" },
        { "from": "runtimes/node-win-x64", "to": "runtimes/node-win-x64" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forge"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/logos/forge-logo.png",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "10.15.0",
      "hardenedRuntime": true,
      "notarize": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "binaries": [
        "Resources/runtimes/node-darwin-arm64/bin/node",
        "Resources/runtimes/node-darwin-x64/bin/node"
      ],
      "extraResources": [
        { "from": "runtimes/node-darwin-arm64", "to": "runtimes/node-darwin-arm64" },
        { "from": "runtimes/node-darwin-x64", "to": "runtimes/node-darwin-x64" }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "login.html",
      "accounts.html",
      "onboarding.html",
      "roblox-studio.html",
      "projects.html",
      "project-create.html",
      "project-settings.html",
      "project-setup.html",
      "workspace.html",
      "agents.html",
      "api-keys.html",
      "thumbnail.html",
      "settings.html",
      "forge-system-prompt.md",
      "lib/**/*",
      "assets/**/*",
      "xterm-assets/**/*",
      "scripts/setup.ps1",
      "scripts/setup-macos.sh",
      "scripts/postinstall.js",
      "ForgePlugin.rbxmx"
    ],
    "extraResources": [
      {
        "from": "../robloxstudio-mcp/dist",
        "to": "robloxstudio-mcp/dist"
      },
      {
        "from": "../robloxstudio-mcp/node_modules",
        "to": "robloxstudio-mcp/node_modules"
      },
      {
        "from": "../robloxstudio-mcp/package.json",
        "to": "robloxstudio-mcp/package.json"
      },
      {
        "from": "ForgePlugin.rbxmx",
        "to": "ForgePlugin.rbxmx"
      }
    ],
    "beforePack": "./scripts/verify-packaged-runtimes.cjs"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9"
  },
  "overrides": {
    "fast-uri": "^3.1.8"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true,
    "lzma-native@8.0.6": true
  }
}
